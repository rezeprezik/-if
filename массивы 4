/код подсчитывает количество чётных чисел в массиве с помощью цикла while и выводит результат на экран
#include <stdio.h>

int main() {
    int arr[] = {1, 2, 3, 4, 5, 6};
    int count = 0;
    int i = 0;
    
    while (i < 6) {
        if (arr[i] % 2 == 0) {
            count++; // Увеличиваем счетчик
        }
        i++;
    }
    
    printf("Количество четных чисел: %d\n", count);
    return 0;
}

/Проверка деления на 2 без остатка и подсчет совпадений
