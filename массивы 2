#include <stdio.h>

int main() {
    int arr[] = {5, 3, 8, 2, 4};
    int sum = 0;
    int i = 0; // счетчик
    
    // Цикл while выполняется, пока индекс меньше размера массива
    while (i < 5) {
        sum += arr[i];
        i++; // Увеличение счетчика
    }
    
    printf("Сумма элементов: %d\n", sum);
    return 0;
}

/Итеративное сложение содержимого всего массива в одну переменную
