/код ищет заданное число (target) в массиве с помощью линейного поиска, сохраняет его индекс и сразу прерывает работу цикла, как только элемент найден
#include <stdio.h>

int main() {
    int arr[] = {10, 25, 40, 55, 70};
    int target = 40; // Какое число
    int index = -1;  // Переменная индекса (-1, если не найдено)
    int i = 0;
    
    while (i < 5) {
        if (arr[i] == target) {
            index = i; // Сохраняем индекс
            break;     // выходим из цикла
        }
        i++;
    }
    
    printf("Элемент %d найден на индексе: %d\n", target, index);
    return 0;
}

/Перебор ячеек до первого совпадения с выходом из цикла
