#include <stdio.h>

int main() {
    int arr[] = {12, 45, 2, 67, 34, 23};
    int max = arr; // считаем первый элемент максимальным
    
    for (int i = 1; i < 6; i++) {
        if (arr[i] > max) {
            max = arr[i]; // Обновляем максимум, если нашли элемент больше
        }
    }
    
    printf("Максимальный элемент в массиве: %d\n", max);
    return 0;
}

