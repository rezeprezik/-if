/код задумывался для того, чтобы скопировать все элементы из одного массива (source) в другой (destination) и вывести результат на экран
#include <stdio.h>

int main() {
    int source[] = {1, 2, 3, 4};
    int destination;
    
    // Копирование элементов
    for (int i = 0; i < 4; i++) {
        destination[i] = source[i];
    }
    
    // Вывод скопированного массива для проверки
    for (int i = 0; i < 4; i++) {
        printf("%d ", destination[i]);
    }
    
    return 0;
}

