#include <stdio.h>

int main() {
    int arr[] = {10, 20, 30, 40, 50};
    
    // Цикл for для перебора индексов от 0 до 4
    for (int i = 0; i < 5; i++) {
        printf("arr[%d] = %d\n", i, arr[i]);
    }
    
    return 0;
}

/Последовательное чтение индексов ячеек и вывод их значений
